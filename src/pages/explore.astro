---
import { getCollection } from 'astro:content';
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import { sections } from '../data/sections';
const posts = (await getCollection('blog')).filter(post => !post.data.draft);
---
<ArchiveLayout title="INNER SEA" kicker="CHOOSE YOUR CURRENT" description="四种方向，同一片内海。选择一个坐标，开始这次漫游。">
  <div class="sea-atlas">
    <noscript><p>选择栏目：{sections.map(section => <a class="quiet-link" href={section.href}>{section.zh}</a>)}</p></noscript>
    <section class="atlas-map" aria-label="选择探索海域">
      <div class="atlas-orbit" aria-hidden="true"></div>
      <svg class="atlas-lines" viewBox="0 0 600 560" aria-hidden="true"><path d="M90 100 L430 170 L150 370 L470 450 M430 170 L470 450 M90 100 L150 370"/><circle cx="300" cy="280" r="190"/><circle cx="300" cy="280" r="95"/></svg>
      <p class="atlas-word" aria-hidden="true">SEA<br />OF ME</p>
      {sections.map((section,index) => <button type="button" class:list={['atlas-node',`node-${index}`,{selected:index===0}]} data-sea={section.slug} aria-pressed={index===0} aria-controls={`sea-${section.slug}`}><span>{section.number} / {section.en}</span><strong>{section.zh}</strong><i aria-hidden="true">↗</i></button>)}
      <span class="atlas-coordinate" aria-hidden="true">22°32′35″ N<br />114°03′28″ E</span>
    </section>
    <div class="atlas-transmission" aria-live="polite">
      {sections.map((section,index) => <section id={`sea-${section.slug}`} data-sea-panel={section.slug} hidden={index!==0} class="atlas-detail"><span class="detail-index" aria-hidden="true">{section.number}</span><p class="detail-code">{section.code}</p><h2>{section.en}</h2><h3>{section.zh}</h3><p class="detail-statement">{section.statement}</p><div class="detail-meter"><span>{posts.filter(post=>post.data.category===section.slug).length} 篇公开记录</span><span>航线已连接</span></div><a class="signal-button" href={section.href}>进入这片海域 ↗</a><a class="atlas-back" href="/blog/">查看全部记录</a></section>)}
    </div>
  </div>
  <section class="atlas-note"><span aria-hidden="true">✳</span><p>不必一次抵达所有地方。<br /><strong>从今天好奇的那一页开始。</strong></p><a href="/friends/">寻找其他海岸 ↗</a></section>
</ArchiveLayout>
<script>
  const nodes=[...document.querySelectorAll<HTMLButtonElement>('[data-sea]')];
  const panels=[...document.querySelectorAll<HTMLElement>('[data-sea-panel]')];
  function selectSea(slug:string, sync=true) { if(!nodes.some(node=>node.dataset.sea===slug)) slug='essays'; for(const node of nodes) { const active=node.dataset.sea===slug; node.classList.toggle('selected',active); node.setAttribute('aria-pressed',String(active)); } for(const panel of panels) panel.hidden=panel.dataset.seaPanel!==slug; if(sync) { const url=new URL(location.href); url.searchParams.set('sea',slug); history.replaceState(null,'',url); } }
  nodes.forEach(node=>node.addEventListener('click',()=>selectSea(node.dataset.sea!)));
  selectSea(new URLSearchParams(location.search).get('sea')||'essays',false);
  window.addEventListener('popstate',()=>selectSea(new URLSearchParams(location.search).get('sea')||'essays',false));
</script>
<style>
  .sea-atlas { display:grid; grid-template-columns:1.25fr 1fr; min-height:540px; border-top:2px solid #5de1f4; }
  .atlas-map { position:relative; min-height:540px; overflow:hidden; background:radial-gradient(ellipse at center,#0878c977,#020a28bb 70%); }
  .atlas-lines { position:absolute; inset:0; width:100%; height:100%; fill:none; stroke:#5de1f4; stroke-width:1; opacity:.35; }
  .atlas-lines path { stroke-dasharray:5 9; }
  .atlas-orbit { position:absolute; inset:10% 14%; border:28px solid #5de1f40a; border-radius:50%; outline:1px solid #5de1f422; transform:rotate(-20deg); }
  .atlas-word { position:absolute; top:18%; left:20%; margin:0; font:italic clamp(5rem,10vw,9rem)/.85 'Anton',sans-serif; color:#5de1f41a; transform:rotate(-9deg); }
  .atlas-node { position:absolute; display:grid; gap:10px; width:46%; padding:20px 30px 20px 20px; text-align:left; border:1px solid #8cdbed; border-left:4px solid #5de1f4; background:#03174df2; color:#f5fbff; cursor:pointer; transform:skewY(-5deg); transition:background 160ms,transform 160ms; }
  .atlas-node span { font:.65rem 'IBM Plex Mono',monospace; color:#91d8f1; }
  .atlas-node strong { font:700 clamp(1rem,2vw,1.4rem) 'Microsoft YaHei',sans-serif; }
  .atlas-node i { position:absolute; right:12px; top:12px; font-style:normal; }
  .atlas-node.selected { background:#f5fbff; color:#03174d; box-shadow:8px 8px #0878c9; transform:skewY(-5deg) translateY(-5px); }
  .atlas-node.selected span { color:#075bb0; }
  .atlas-node:hover { border-color:#ff6375; }
  .node-0 { top:10%; left:5%; }.node-1 { top:29%; right:4%; }.node-2 { top:58%; left:6%; }.node-3 { top:77%; right:3%; }
  .atlas-coordinate { position:absolute; left:6%; bottom:5%; font:.6rem/1.7 'IBM Plex Mono',monospace; color:#8cbacc; }
  .atlas-transmission { background:#f5fbff; color:#03174d; position:relative; overflow:hidden; }
  .atlas-detail { position:relative; padding:45px 35px; overflow:hidden; min-height:100%; }
  .detail-index { position:absolute; top:-30px; right:-6px; font:16rem 'Anton',sans-serif; color:#075bb00c; pointer-events:none; }
  .detail-code { position:relative; font:.7rem 'IBM Plex Mono',monospace; letter-spacing:.12em; color:#075bb0; }
  h2 { position:relative; font:italic clamp(2.4rem,4.5vw,4.2rem)/1 'Anton',sans-serif; letter-spacing:-.03em; margin:55px 0 18px; overflow-wrap:anywhere; }
  h3 { position:relative; font-size:1.5rem; margin:0 0 26px; }
  .detail-statement { position:relative; font:1rem/1.9 'Microsoft YaHei',sans-serif; min-height:70px; }
  .detail-meter { display:flex; justify-content:space-between; border-top:1px solid #8cbbd1; margin:28px 0; padding-top:12px; font-size:.7rem; }
  .atlas-back { display:block; color:#075bb0; font-size:.85rem; padding-top:22px; text-decoration:underline; text-underline-offset:5px; }
  .atlas-note { display:flex; gap:25px; align-items:center; padding:35px 0; }.atlas-note>span { color:#ff6375; font-size:3rem; }.atlas-note p { line-height:1.8; font-size:1rem; }.atlas-note a { margin-left:auto; color:#5de1f4; text-decoration:underline; }
  @media(max-width:760px) { .sea-atlas { grid-template-columns:1fr; }.atlas-map { min-height:400px; }.atlas-node { padding:17px 12px; }.atlas-node span { font-size:.5rem; }.atlas-detail { padding:28px 24px; }h2 { margin-top:28px; }.atlas-note { flex-wrap:wrap; gap:12px; }.atlas-note a { margin-left:0; } }
  @media(prefers-reduced-motion:reduce) { .atlas-node { transition:none; } }
  @media(prefers-reduced-motion:no-preference) { .atlas-detail { animation:receive-signal 260ms ease-out; } }
  @keyframes receive-signal { from { opacity:.3; transform:translateX(12px); } to { opacity:1; transform:translateX(0); } }
</style>
