---
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import { listeningNotes } from '../data/listening';

const moods = [
	{ value: 'all', label: '全部频率' },
	{ value: 'chill', label: '松口气' },
	{ value: 'renewal', label: '向新生' },
];
---

<ArchiveLayout title="潮间听" kicker="BETWEEN TIDES / LISTENING NOTES" description="让一首歌，接住此刻的心情。" compactHeading>
	<header slot="heading" class="listening-intro">
		<div><p class="intro-caption"><span aria-hidden="true"></span> tide 的音乐手记</p><h1>潮间听<span lang="en">Between tides.</span></h1><p class="intro-description">让一首歌，接住此刻的心情。</p></div>
		<div class="intro-tide" aria-hidden="true"><span>心情有潮汐，音乐有回声。</span><svg viewBox="0 0 360 84"><path d="M0 48 C60 -8 100 104 180 48 S300 -8 360 48"/><path d="M0 60 C60 4 100 116 180 60 S300 4 360 60"/><path d="M0 72 C60 16 100 128 180 72 S300 16 360 72"/></svg></div>
	</header>
	<section class="listening-shelf" aria-label="歌曲与心情随笔">
		<div class="shelf-heading">
		<div class="mood-filters" role="group" aria-label="按心情筛选歌曲" data-mood-filters hidden>
			{moods.map((mood) => <button type="button" data-mood-filter={mood.value} aria-pressed={mood.value === 'all'} aria-controls="listening-cards">{mood.label}</button>)}
		</div>
			<p class="shelf-count"><span class="signal-dot" aria-hidden="true"></span><span data-note-count aria-live="polite">{String(listeningNotes.length).padStart(2, '0')} 首在听</span></p>
		</div>
		<div class="listening-grid" id="listening-cards">
			{listeningNotes.map((entry) => (
				<article class:list={['listening-card', entry.mood]} id={entry.id} data-note-mood={entry.mood} aria-labelledby={`title-${entry.id}`}>
					<div class="cover-light" aria-hidden="true"><img src={entry.cover} alt="" width="300" height="300" loading="lazy" /></div>
					<div class="glass-surface" aria-hidden="true"></div>
					<div class="card-content">
						<div class="card-overline"><span class="mood-label"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">{entry.mood === 'renewal' ? <><path d="M4 17h16M7 14a5 5 0 0 1 10 0M12 3v3M4 8l2 2M20 8l-2 2"/><path d="M9 21h6"/></> : <><path d="M2 9c3-5 7 5 10 0s7 5 10 0M2 16c3-5 7 5 10 0s7 5 10 0"/></>}</svg>{entry.moodLabel}</span><a class="track-link" href={entry.spotifyUrl} target="_blank" rel="noopener noreferrer" aria-label={`在 Spotify 打开 ${entry.artist} 的 ${entry.track}`}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a></div>
						<div class="track-heading"><div class="record-sleeve"><div class="vinyl" aria-hidden="true"><i></i></div><img class="album-cover" src={entry.cover} alt={`${entry.artist}《${entry.album}》专辑封面`} width="112" height="112" loading="lazy" /></div><div class="track-info"><h2 id={`title-${entry.id}`}><a href={entry.spotifyUrl} target="_blank" rel="noopener noreferrer">{entry.track}</a></h2><p class="artist">{entry.artist}</p><p class="album-meta">{entry.album}<span aria-hidden="true"> / </span>{entry.duration}</p></div></div>
						{entry.note ? <div class="personal-note">{entry.note.split(/\n\s*\n|\n/).filter(Boolean).map(paragraph => <p>{paragraph}</p>)}</div> : <div class="note-space" aria-label="随笔正文暂留空"><span>随笔待续</span><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i></div>}
						<details class="track-player">
							<summary><span class="listen-action"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m9 5 10 7-10 7Z"/></svg><span>听这首歌</span></span><span class="equalizer" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span></summary>
							<iframe title={`Spotify 播放器：${entry.artist} — ${entry.track}`} src={`https://open.spotify.com/embed/track/${entry.spotifyId}?utm_source=generator&theme=0`} width="100%" height="80" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
							<p class="player-help">无法试听？<a href={entry.spotifyUrl} target="_blank" rel="noopener noreferrer">到 Spotify 听 ↗</a></p>
						</details>
						<div class="card-footer"><a class="spotify-credit" href={entry.spotifyUrl} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M6 9c4-1 8-.5 12 1M7 12c3-.8 6.5-.3 10 1M8 15c2.5-.5 5-.2 8 1" fill="none" stroke="#122c53" stroke-width="1.6" stroke-linecap="round"/></svg> Spotify</a><a class="note-permalink" href={`#${entry.id}`} aria-label={`定位到 ${entry.track} 的随笔`}>留在这一刻 <span aria-hidden="true">⌁</span></a></div>
					</div>
				</article>
			))}
		</div>
		<div class="shelf-footer"><span class="footer-signature">tide</span><svg viewBox="0 0 280 32" aria-hidden="true"><path d="M0 16 Q17 0 35 16 T70 16 T105 16 T140 16 T175 16 T210 16 T245 16 T280 16" /></svg><span>下一首，随心情抵达。</span></div>
	</section>
</ArchiveLayout>

<script>
	const filters = document.querySelector<HTMLElement>('[data-mood-filters]');
	const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-mood-filter]')];
	const cards = [...document.querySelectorAll<HTMLElement>('[data-note-mood]')];
	const count = document.querySelector<HTMLElement>('[data-note-count]');
	filters?.removeAttribute('hidden');
	buttons.forEach(button => button.addEventListener('click', () => {
		const mood = button.dataset.moodFilter;
		buttons.forEach(option => option.setAttribute('aria-pressed', String(option === button)));
		cards.forEach(card => {
			card.hidden = mood !== 'all' && card.dataset.noteMood !== mood;
			if (card.hidden) {
				const player = card.querySelector<HTMLDetailsElement>('details');
				if (player?.open) player.open = false;
			}
		});
		if (count) count.textContent = `${String(cards.filter(card => !card.hidden).length).padStart(2, '0')} 首在听`;
	}));
	// Mount on demand and unload when closed, so a hidden player cannot keep playing.
	document.querySelectorAll<HTMLDetailsElement>('.track-player').forEach(player => {
		const frame = player.querySelector<HTMLIFrameElement>('iframe');
		if (!frame) return;
		const source = frame.src;
		frame.removeAttribute('src');
		player.addEventListener('toggle', () => {
			if (player.open) {
				document.querySelectorAll<HTMLDetailsElement>('.track-player[open]').forEach(other => { if (other !== player) other.open = false; });
				frame.src = source;
			} else frame.removeAttribute('src');
		});
	});
</script>

<style>
  :global(.archive-main:has(.listening-shelf)) { padding-top:60px; max-width:1080px; }
  :global(.archive-shell:has(.listening-shelf)) { background:radial-gradient(ellipse at 9% 36%,#176eb052,transparent 44%),radial-gradient(ellipse at 92% 48%,#7c60853b,transparent 38%),linear-gradient(155deg,#062e63,#031b48 46%,#020b29); }
  .listening-intro { display:flex; align-items:center; justify-content:space-between; gap:40px; margin:0 0 38px; }
  .intro-caption { display:flex; align-items:center; gap:10px; color:#b1d6e8; font-size:13px; letter-spacing:.12em; margin:0 0 18px; }
  .intro-caption>span { width:6px; height:6px; background:#90e5ee; border-radius:50%; box-shadow:0 0 14px #5de1f4aa; }
  h1 { display:flex; align-items:baseline; gap:24px; margin:0; color:#f5fbff; font:600 clamp(2.8rem,5vw,4.5rem)/1.2 'Microsoft YaHei',sans-serif; letter-spacing:-.05em; }
  h1>span { color:#a1c5dd; font:italic 400 clamp(1.6rem,3vw,2.5rem)/1 'Cormorant Garamond',serif; letter-spacing:-.03em; }
  .intro-description { margin:18px 0 0; color:#bed5e6; font:14px/1.8 'Microsoft YaHei',sans-serif; letter-spacing:.08em; }
  .intro-tide { padding-top:34px; width:245px; color:#a5c7db; text-align:right; font-size:12px; letter-spacing:.12em; }
  .intro-tide svg { display:block; width:100%; height:65px; margin-top:14px; stroke:#a9edff; stroke-width:1; fill:none; }
  .intro-tide path:nth-child(2) { opacity:.45; }.intro-tide path:nth-child(3) { opacity:.18; }
  .listening-shelf { position:relative; isolation:isolate; }
  .listening-shelf::before { content:''; position:absolute; z-index:-1; top:80px; left:14%; width:62%; height:340px; border-radius:50%; background:radial-gradient(ellipse,#379ec965,transparent 65%); filter:blur(38px); pointer-events:none; }
  .shelf-heading { display:flex; align-items:center; justify-content:space-between; gap:16px; border-top:1px solid #b4e4fc30; padding:19px 0 25px; }
  .mood-filters { display:flex; flex-wrap:wrap; gap:8px; }
  .mood-filters button { min-height:44px; padding:10px 20px; border:1px solid transparent; border-radius:24px; color:#b5d0e2; background:transparent; font:13px 'Microsoft YaHei',sans-serif; cursor:pointer; transition:background 180ms,color 180ms,border-color 180ms; }
  .mood-filters button[aria-pressed=true] { color:#f4fcff; background:#c8edff19; border-color:#cef3ff45; box-shadow:inset 0 1px #ffffff15,0 5px 16px #00132c1a; }
  .mood-filters button:hover { background:#c8edff20; color:#fff; }
  .shelf-count { display:flex; align-items:center; gap:9px; margin:0; color:#b5d0e2; font-size:12px; white-space:nowrap; }
  .signal-dot { height:5px; width:5px; border-radius:50%; background:#9edbdc; }
  .listening-grid { display:grid; grid-template-columns:1.12fr 1fr; gap:24px; align-items:start; }
  .listening-card { position:relative; isolation:isolate; min-width:0; overflow:hidden; border:1px solid #d9f0ff40; border-radius:24px; box-shadow:0 24px 70px #000d2d50,0 4px 12px #000b2826,inset 0 1px 0 #ffffff2b; scroll-margin-top:30px; }
  .listening-card.chill { margin-top:38px; }
  .cover-light { position:absolute; z-index:-3; inset:-35% -25% -20%; opacity:.54; pointer-events:none; background:#547393; }
  .cover-light img { height:100%; width:100%; object-fit:cover; filter:blur(62px) saturate(.7); transform:scale(1.12); }
  .glass-surface { position:absolute; z-index:-2; inset:0; background:linear-gradient(135deg,#afcbd230,#102c56b8 55%,#07234cbf); -webkit-backdrop-filter:blur(28px) saturate(115%); backdrop-filter:blur(28px) saturate(115%); pointer-events:none; }
  .chill .glass-surface { background:linear-gradient(140deg,#d3c6da1c,#193354bd 65%,#0b2853d4); }
  .glass-surface::after { content:''; position:absolute; inset:0; opacity:.16; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Cpath fill='%23fff' filter='url(%23n)' opacity='.4' d='M0 0h180v180H0z'/%3E%3C/svg%3E"); background-size:150px; }
  .card-content { position:relative; padding:20px 28px 15px; }
  .card-overline { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:14px; }
  .mood-label { display:flex; align-items:center; gap:8px; font:12px 'Microsoft YaHei',sans-serif; color:#ffbcc3; }
  .chill .mood-label { color:#b5eff3; }
  .mood-label svg,.track-link svg { fill:none; stroke:currentColor; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
  .track-link { display:grid; place-items:center; width:44px; height:44px; margin-right:-8px; color:#d6e9f5; border-radius:50%; transition:background 180ms; }
  .track-link:hover { background:#ffffff16; color:#fff; }
  .track-heading { display:flex; align-items:center; gap:22px; min-height:116px; }
  .record-sleeve { position:relative; width:132px; height:112px; flex-shrink:0; }
  .album-cover { position:relative; display:block; z-index:1; width:104px; height:104px; border-radius:9px; object-fit:cover; box-shadow:0 8px 20px #000b385c; }
  .vinyl { position:absolute; right:0; top:1px; width:102px; height:102px; border-radius:50%; background:repeating-radial-gradient(circle at center,#17232f 0 1px,#0a121d 2px 3px); box-shadow:0 5px 15px #000b2840; border:1px solid #d0efff28; }
  .vinyl::after { content:''; position:absolute; inset:0; border-radius:50%; background:conic-gradient(from 45deg,transparent,#bfd9e52a,transparent 35%,transparent 65%,#bfd9e52a,transparent); }
  .vinyl i { position:absolute; inset:35%; border-radius:50%; background:#a5c3ca; box-shadow:inset 0 0 0 10px #2e4b59; }
  .chill .vinyl i { background:#e5abc9; box-shadow:inset 0 0 0 10px #a56d95; }
  .track-info { min-width:0; }
  h2 { margin:0; font:600 clamp(1.6rem,2.5vw,2.1rem)/1.1 'Barlow Condensed',sans-serif; color:#fff; overflow-wrap:anywhere; }
  h2 a:hover { color:#b5f0ff; }
  .artist { margin:9px 0 0; font:14px/1.4 'Barlow Condensed',sans-serif; color:#e3edf5; }
  .album-meta { margin:7px 0 0; color:#b4cada; font:12px/1.4 'Barlow Condensed',sans-serif; letter-spacing:.04em; }
  .album-meta>span { padding:0 5px; color:#87a1b8; }
  .personal-note { padding:24px 0 23px; }
  .personal-note p { margin:0 0 15px; color:#f0f5fa; font:15px/2 'Microsoft YaHei',sans-serif; overflow-wrap:anywhere; }
  .personal-note p:last-child { margin-bottom:0; color:#dae6f0; }
  .note-space { display:grid; gap:23px; padding:31px 0 28px; }
  .note-space span { font:12px 'Microsoft YaHei',sans-serif; color:#c3cfdf; letter-spacing:.12em; }
  .note-space i { height:1px; background:#c2e5ff1c; }.note-space i:last-child { width:65%; }
  .track-player { border-top:1px solid #e0efff24; }
  summary { display:flex; align-items:center; justify-content:space-between; gap:15px; min-height:58px; color:#e6f8ff; font:13px 'Microsoft YaHei',sans-serif; cursor:pointer; list-style:none; }
  summary::-webkit-details-marker { display:none; }
  .listen-action { display:flex; align-items:center; gap:10px; }
  .listen-action svg { fill:#d6f2ff; stroke:#d6f2ff; stroke-linejoin:round; }
  summary:hover { color:#fff; }
  .equalizer { display:flex; align-items:center; gap:3px; height:22px; padding-right:4px; color:#b4dfe9; }
  .equalizer i { display:block; width:2px; height:8px; border-radius:2px; background:currentColor; }
  .equalizer i:nth-child(2),.equalizer i:nth-child(4) { height:15px; }.equalizer i:nth-child(3) { height:21px; }
  .track-player[open] .equalizer { color:#ffb6c1; }
  iframe { display:block; border:0; border-radius:12px; background:#121212; }
  .player-help { margin:12px 0; color:#d2e5f0; font:12px/1.8 'Microsoft YaHei',sans-serif; }
  .player-help a { color:#b2edff; text-decoration:underline; text-underline-offset:3px; }
  .card-footer { display:flex; justify-content:space-between; align-items:center; gap:12px; padding-top:3px; }
  .spotify-credit { display:flex; align-items:center; gap:7px; min-height:44px; color:#c3dbe8; font:13px 'Barlow Condensed',sans-serif; }
  .spotify-credit:hover { color:#fff; }
  .note-permalink { display:flex; align-items:center; gap:8px; min-height:44px; color:#b8cede; font:11px 'Microsoft YaHei',sans-serif; }
  .note-permalink:hover { color:#e6f8ff; }.note-permalink>span { font-size:24px; color:#c2dfeb; }
  .shelf-footer { display:flex; align-items:center; gap:18px; padding:35px 0 0; color:#a3c3d6; }
  .footer-signature { color:#b8dce9; font:italic 30px 'Cormorant Garamond',serif; }
  .shelf-footer svg { height:22px; width:110px; stroke:#9ad7eb; fill:none; opacity:.45; }
  .shelf-footer>span:last-child { margin-left:auto; font:12px 'Microsoft YaHei',sans-serif; }
  @supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))) { .glass-surface,.chill .glass-surface { background:#13315aed; } }
  @media(max-width:900px) { :global(.archive-main:has(.listening-shelf)) { padding-top:42px; }.intro-tide { width:190px; }.listening-grid { grid-template-columns:1fr 1fr; gap:18px; }.card-content { padding:16px 20px 12px; }.record-sleeve { width:108px; height:92px; }.album-cover { width:86px; height:86px; }.vinyl { width:84px; height:84px; }.track-heading { gap:13px; min-height:92px; }h2 { font-size:1.65rem; }h1 { flex-wrap:wrap; gap:8px 20px; }.artist { font-size:13px; } }
  @media(max-width:680px) { .listening-intro { margin-bottom:28px; }.intro-tide { display:none; }h1 { font-size:3rem; }h1>span { font-size:1.8rem; }.intro-caption { font-size:12px; margin-bottom:13px; }.intro-description { font-size:13px; margin-top:14px; }.listening-grid { grid-template-columns:minmax(0,1fr); max-width:480px; margin-inline:auto; gap:20px; }.listening-card.chill { margin-top:0; }.listening-card { border-radius:21px; }.card-content { padding:16px 22px 12px; }.shelf-heading { gap:8px; padding:15px 0 20px; }.mood-filters { gap:2px; }.mood-filters button { padding:10px 14px; font-size:12px; }.shelf-count { font-size:11px; gap:6px; }.track-heading { gap:18px; }.personal-note { padding:22px 0; }.personal-note p { font-size:14px; }.shelf-footer { gap:12px; }.shelf-footer svg { width:70px; }.shelf-footer>span:last-child { font-size:11px; }.cover-light img { filter:blur(40px) saturate(.7); } }
  @media(max-width:360px) { .card-content { padding-inline:18px; }.record-sleeve { width:91px; height:80px; }.album-cover { width:73px; height:73px; }.vinyl { width:72px; height:72px; }.track-heading { gap:13px; min-height:80px; }h2 { font-size:1.5rem; }h1 { gap:6px 16px; }h1>span { font-size:1.5rem; }.mood-filters button { padding:10px 11px; }.shelf-count { font-size:10px; }.signal-dot { display:none; } }
  @media(prefers-reduced-motion:reduce) { .mood-filters button,.track-link { transition:none; } }
</style>
