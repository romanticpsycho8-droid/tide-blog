---
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import { listeningNotes } from '../data/listening';
const moods = [
  { value: 'all', label: '全部' },
  { value: 'chill', label: '松口气' },
  { value: 'renewal', label: '向新生' },
];
---
<ArchiveLayout title="潮间听" description="让一首歌，接住此刻的心情。">
  <header slot="heading" class="listening-intro">
    <h1>潮间听</h1>
    <p>一些歌，<br />和听歌时的我。</p>
  </header>
  <section class="listening-shelf" aria-label="歌曲与心情随笔">
    <div class="shelf-heading">
      <div class="mood-filters" role="group" aria-label="按心情筛选歌曲" data-mood-filters hidden>
        {moods.map(mood => <button type="button" data-mood-filter={mood.value} aria-pressed={mood.value === 'all'} aria-controls="listening-cards">{mood.label}</button>)}
      </div>
      <span class="note-count" data-note-count aria-live="polite">{String(listeningNotes.length).padStart(2, '0')} 首在听</span>
    </div>
    <div class="listening-grid" id="listening-cards">
      {listeningNotes.map(entry => (
        <article class:list={['listening-entry', { 'has-note': entry.note || entry.quote }]} id={entry.id} data-note-mood={entry.mood} aria-labelledby={`title-${entry.id}`}>
          <header class="track-heading">
            <a class="cover-link" href={entry.spotifyUrl} target="_blank" rel="noopener noreferrer" aria-label={`在 Spotify 打开 ${entry.artist} 的 ${entry.track}`}><img class="album-cover" src={entry.cover} alt={`${entry.artist}《${entry.album}》专辑封面`} width="72" height="72" loading="lazy" /></a>
            <div class="track-info"><h2 id={`title-${entry.id}`}><a href={entry.spotifyUrl} target="_blank" rel="noopener noreferrer">{entry.track}</a></h2><p>{entry.artist}<span>{entry.duration}</span></p></div>
            <span class="mood-label">{entry.moodLabel}</span>
          </header>
          {entry.quote && <blockquote class="song-quote" lang="en">{entry.quote}</blockquote>}
          {entry.note ? <div class="personal-note">{entry.note.split(/\n\s*\n|\n/).filter(Boolean).map(paragraph => <p>{paragraph}</p>)}</div> : <div class="note-space" aria-label="随笔正文暂留空"><span>随笔待续</span><i aria-hidden="true"></i><i aria-hidden="true"></i></div>}
          <div class="entry-footer">
            <details class="track-player">
              <summary><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m8 5 11 7-11 7Z" /></svg><span>听这首歌</span><span class="player-state" aria-hidden="true"></span></summary>
              <iframe title={`Spotify 播放器：${entry.artist} — ${entry.track}`} src={`https://open.spotify.com/embed/track/${entry.spotifyId}?utm_source=generator&theme=0`} width="100%" height="80" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
              <p class="player-help">无法试听？<a href={entry.spotifyUrl} target="_blank" rel="noopener noreferrer">到 Spotify 听</a></p>
            </details>
            <div class="entry-links"><a href={entry.spotifyUrl} target="_blank" rel="noopener noreferrer">Spotify ↗</a><a href={`#${entry.id}`} aria-label={`定位到 ${entry.track} 的随笔`}># {entry.track.toLowerCase()}</a></div>
          </div>
        </article>
      ))}
    </div>
    <p class="shelf-end">下一首，随心情抵达。</p>
  </section>
</ArchiveLayout>

<script>
	const filters = document.querySelector<HTMLElement>('[data-mood-filters]');
	const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-mood-filter]')];
	const cards = [...document.querySelectorAll<HTMLElement>('[data-note-mood]')];
	const count = document.querySelector<HTMLElement>('[data-note-count]');
	filters?.removeAttribute('hidden');
	buttons.forEach(button => button.addEventListener('click', () => {
		const mood = button.dataset.moodFilter;
		buttons.forEach(option => option.setAttribute('aria-pressed', String(option === button)));
		cards.forEach(card => {
			card.hidden = mood !== 'all' && card.dataset.noteMood !== mood;
			if (card.hidden) {
				const player = card.querySelector<HTMLDetailsElement>('details');
				if (player?.open) player.open = false;
			}
		});
		if (count) count.textContent = `${String(cards.filter(card => !card.hidden).length).padStart(2, '0')} 首在听`;
	}));
	// Mount on demand and unload when closed, so a hidden player cannot keep playing.
	document.querySelectorAll<HTMLDetailsElement>('.track-player').forEach(player => {
		const frame = player.querySelector<HTMLIFrameElement>('iframe');
		if (!frame) return;
		const source = frame.src;
		frame.removeAttribute('src');
		player.addEventListener('toggle', () => {
			if (player.open) {
				document.querySelectorAll<HTMLDetailsElement>('.track-player[open]').forEach(other => { if (other !== player) other.open = false; });
				frame.src = source;
			} else frame.removeAttribute('src');
		});
	});
</script>

<style>
  :global(.archive-shell:has(.listening-shelf)) { background:#092b61; }
  :global(.archive-shell:has(.listening-shelf) .archive-grid),:global(.archive-shell:has(.listening-shelf) .archive-glow),:global(.archive-shell:has(.listening-shelf) .archive-depth) { display:none; }
  :global(.archive-main:has(.listening-shelf)) { width:min(1040px,calc(100% - 56px)); padding-top:64px; min-height:calc(100vh - 200px); }
  .listening-intro { display:flex; align-items:center; gap:40px; margin-bottom:40px; }
  h1 { margin:0; color:#f5fbff; font:700 clamp(3.4rem,6.5vw,5.4rem)/1.1 'Microsoft YaHei',sans-serif; letter-spacing:-.06em; }
  .listening-intro>p { margin:5px 0 0; padding-left:25px; border-left:2px solid #ff7181; color:#c0d7e9; font:14px/1.9 'Microsoft YaHei',sans-serif; }
  .shelf-heading { display:flex; justify-content:space-between; align-items:center; gap:20px; margin-bottom:25px; }
  .mood-filters { display:flex; gap:24px; }
  .mood-filters button { position:relative; padding:8px 0 12px; min-height:44px; border:0; background:none; color:#b2cae0; font:14px 'Microsoft YaHei',sans-serif; cursor:pointer; }
  .mood-filters button[aria-pressed=true] { color:#fff; }
  .mood-filters button[aria-pressed=true]::after { content:''; position:absolute; bottom:0; left:0; width:100%; height:2px; background:#ff7181; }
  .mood-filters button:hover { color:#fff; }
  .note-count { color:#b2cae0; font:12px 'Microsoft YaHei',sans-serif; }
  .listening-grid { display:grid; grid-template-columns:1.25fr .9fr; gap:42px; align-items:start; }
  .listening-entry { min-width:0; color:#eef6fc; padding:23px 0 0; border-top:2px solid #bcdbe7; scroll-margin-top:28px; }
  .listening-entry.has-note { padding:28px 30px 20px; border:0; background:#e9f3f5; color:#082a50; }
  .track-heading { display:flex; align-items:center; gap:15px; }
  .cover-link { display:block; flex-shrink:0; }
  .album-cover { display:block; width:65px; height:65px; object-fit:cover; }
  .track-info { min-width:0; flex:1; }
  h2 { margin:0; font:600 clamp(1.6rem,2.3vw,2rem)/1.1 'Barlow Condensed',sans-serif; overflow-wrap:anywhere; }
  h2 a:hover { text-decoration:underline; text-underline-offset:5px; }
  .track-info p { display:flex; flex-wrap:wrap; align-items:center; gap:7px 16px; margin:7px 0 0; font:14px 'Barlow Condensed',sans-serif; color:#bfd5e6; }
  .has-note .track-info p { color:#42617b; }
  .track-info p>span { font-size:12px; }
  .mood-label { align-self:flex-start; padding-top:2px; font:11px/1.5 'Microsoft YaHei',sans-serif; color:#bfd5e6; white-space:nowrap; }
  .has-note .mood-label { color:#42617b; }
  .song-quote { max-width:440px; margin:31px 0 22px; font:600 clamp(2.6rem,4.1vw,3.5rem)/1.05 'Cormorant Garamond',serif; letter-spacing:-.035em; text-wrap:balance; }
  .personal-note { padding:0 0 25px; }
  .personal-note p { margin:0 0 15px; font:14px/1.95 'Microsoft YaHei',sans-serif; overflow-wrap:anywhere; }
  .personal-note p:first-child { font-size:13px; color:#42617b; }
  .personal-note p:last-child { margin-bottom:0; }
  .note-space { display:grid; gap:29px; padding:40px 0 43px; }
  .note-space span { font:13px 'Microsoft YaHei',sans-serif; color:#bed4e7; }
  .note-space i { display:block; height:1px; background:#bdd8ee2b; }.note-space i:last-child { width:65%; }
  .entry-footer { border-top:1px solid #b5d6ea44; }
  .has-note .entry-footer { border-color:#082a5029; }
  .track-player { width:100%; }
  summary { display:flex; align-items:center; gap:9px; min-height:51px; list-style:none; cursor:pointer; font:13px 'Microsoft YaHei',sans-serif; }
  summary::-webkit-details-marker { display:none; }
  summary svg { fill:currentColor; }
  summary:hover>span:first-of-type { text-decoration:underline; text-underline-offset:4px; }
  .player-state { margin-left:auto; font-size:18px; font-family:Arial,sans-serif; }
  .player-state::after { content:'+'; }.track-player[open] .player-state::after { content:'−'; }
  iframe { display:block; border:0; background:#121212; }
  .player-help { margin:11px 0; font:12px/1.8 'Microsoft YaHei',sans-serif; }
  .player-help a { text-decoration:underline; text-underline-offset:3px; }
  .entry-links { display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; }
  .entry-links a { display:flex; align-items:center; min-height:36px; font:12px 'Barlow Condensed',sans-serif; color:#bcd3e6; }
  .has-note .entry-links a { color:#42617b; }
  .entry-links a:hover { text-decoration:underline; text-underline-offset:4px; }
  .shelf-end { margin:34px 0 0; text-align:right; font:12px 'Microsoft YaHei',sans-serif; color:#b4cde0; }
  @media(max-width:900px) { .listening-grid { gap:28px; }.listening-entry.has-note { padding:24px; }.track-heading { gap:12px; }.mood-label { display:none; } }
  @media(max-width:680px) { :global(.archive-main:has(.listening-shelf)) { width:calc(100% - 36px); padding-top:40px; padding-bottom:60px; }.listening-intro { gap:20px; margin-bottom:26px; }h1 { font-size:3.4rem; }.listening-intro>p { padding-left:16px; font-size:12px; }.shelf-heading { margin-bottom:20px; }.mood-filters { gap:23px; }.mood-filters button { font-size:13px; }.note-count { font-size:11px; }.listening-grid { grid-template-columns:minmax(0,1fr); gap:38px; max-width:480px; margin-inline:auto; }.listening-entry.has-note { padding:24px 22px 17px; }.listening-entry:not(.has-note) { padding:22px 5px 0; }.song-quote { font-size:2.8rem; margin-top:28px; }.album-cover { width:57px; height:57px; }h2 { font-size:1.7rem; }.personal-note p { font-size:14px; }.personal-note p:first-child { font-size:12px; }.note-space { padding:32px 0; } }
  @media(max-width:360px) { .listening-intro { gap:14px; }h1 { font-size:3rem; }.listening-intro>p { font-size:11px; padding-left:12px; }.listening-entry.has-note { padding-inline:19px; }.album-cover { width:48px; height:48px; }h2 { font-size:1.5rem; }.song-quote { font-size:2.5rem; }.track-info p { gap:7px 12px; } }
</style>
